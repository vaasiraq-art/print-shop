{
  "name": "print-shop",
  "version": "1.0.0",
  "description": "Print Shop - Multi-tab PDF printing tool for print room management",
  "main": "main.js",
  "author": "Vaas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.8.0",
    "puppeteer": "^25.3.0"
  },
  "build": {
    "appId": "com.vaas.printshop",
    "productName": "Print Shop",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Print Shop"
    },
    "portable": {
      "artifactName": "${productName}-Setup.${ext}"
    }
  }
}
